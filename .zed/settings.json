{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy", "extraArgs": ["--", "-D", "warnings"] }
      }
    }
  },
  "languages": {
    "Rust": { "formatter": "language_server", "format_on_save": "on" },
    "Markdown": { "wrap_guides": [105, 110] }
  }
}
